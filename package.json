{
    "name": "@nowtwo-llc/quick-switcher",
    "version": "4.0.1",
    "description": "Keyboard-driven command palette for the web, with nested drill-down searches, breadcrumb navigation, and usage-based result ranking. No runtime dependencies.",
    "keywords": [
        "quick-switcher",
        "command-palette",
        "cmd-k",
        "keyboard",
        "search",
        "navigation",
        "spotlight",
        "typeahead"
    ],
    "author": "NowTwo LLC <support@nowtwo.io> (https://www.nowtwo.io/)",
    "license": "MIT",
    "homepage": "https://github.com/nowtwo-llc/nowtwo-quick-switcher",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nowtwo-llc/nowtwo-quick-switcher.git"
    },
    "bugs": {
        "url": "https://github.com/nowtwo-llc/nowtwo-quick-switcher/issues"
    },
    "type": "module",
    "main": "./dist/quick-switcher.min.js",
    "module": "./dist/quick-switcher.esm.js",
    "types": "./types/index.d.ts",
    "unpkg": "./dist/quick-switcher.min.js",
    "jsdelivr": "./dist/quick-switcher.min.js",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/quick-switcher.esm.js",
            "require": "./dist/quick-switcher.min.js",
            "default": "./dist/quick-switcher.min.js"
        },
        "./style.css": "./dist/quick-switcher.min.css",
        "./scss": "./src/quick-switcher.scss",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "*.css",
        "*.scss"
    ],
    "files": [
        "dist/",
        "types/",
        "src/quick-switcher.scss"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "npm run clean && npm run build:js && npm run build:css && npm run build:types",
        "build:css": "sass --style=compressed --load-path=src src/quick-switcher.scss dist/quick-switcher.min.css",
        "build:demo": "vite build --config demo/vite.config.js",
        "build:js": "vite build",
        "build:prod": "npm run build",
        "build:types": "tsc -p tsconfig.types.json",
        "clean": "node scripts/clean.mjs",
        "clean:dist": "rm -rf dist",
        "demo": "vite --config demo/vite.config.js",
        "format": "prettier --write \"src/**/*.{js,scss}\" \"test/**/*.js\" \"demo/**/*.js\" \"*.{js,mjs,json}\"",
        "format:check": "prettier --check \"src/**/*.{js,scss}\" \"test/**/*.js\" \"demo/**/*.js\" \"*.{js,mjs,json}\"",
        "lint": "npm run oxlint && npm run format && npm run stylelint",
        "lint:check": "oxlint --max-warnings=0 && npm run format:check && npm run stylelint",
        "lint:fix": "npm run lint",
        "oxlint": "oxlint --fix",
        "prepublishOnly": "npm run build",
        "stylelint": "stylelint \"src/**/*.scss\"",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json",
        "update": "npm-check-updates -u",
        "update:check": "npm-check-updates",
        "verify:dist": "node scripts/verify-dist.mjs",
        "watch": "concurrently 'npm run watch:js' 'npm run watch:css'",
        "watch:css": "sass --watch --load-path=src src/quick-switcher.scss dist/quick-switcher.min.css",
        "watch:js": "vite build --watch"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.10",
        "concurrently": "^10.0.4",
        "globals": "^16.5.0",
        "jsdom": "^30.0.1",
        "npm-check-updates": "^23.0.0",
        "oxlint": "^1.77.0",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.9.6",
        "sass": "^1.102.0",
        "stylelint": "^17.14.1",
        "stylelint-prettier": "^5.0.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.0",
        "vitest": "^4.1.10"
    }
}
